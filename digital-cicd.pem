name: Frontend CI/CD

on:
  push:
    branches: [ "dev" ]

jobs:
  ci-pipeline:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set lowercase image name
        run: echo "IMAGE_NAME=$(echo '${{ github.repository }}' | tr '[:upper:]' '[:lower:]')" >> $GITHUB_ENV

      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and Push Frontend Image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./frontend.Dockerfile
          push: true
          # Frontend -----------------
          build-args: |
            NEXT_PUBLIC_API_BASE_URL=${{ secrets.NEXT_PUBLIC_API_BASE_URL }}
          tags: |
            ghcr.io/${{ env.IMAGE_NAME }}/frontend:latest
            ghcr.io/${{ env.IMAGE_NAME }}/frontend:${{ github.sha }}
  #-------------------------Deploy Job-------------------------#

  deploy:
    runs-on: ubuntu-latest
    needs: ci-pipeline
    steps:
      - name: Deploy to DigitalOcean via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.DEV_HOST }}
          username: ${{ secrets.DEV_USER }}
          key: ${{ secrets.DEV_SSH_KEY }}
          script: |
            # 1. GHCR Login
            echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u ${{ github.actor }} --password-stdin
            # 2. Set lowercase image name
            IMAGE_NAME=$(echo "${{ github.repository }}" | tr '[:upper:]' '[:lower:]')
            # 3. Pull latest image
            docker pull ghcr.io/$IMAGE_NAME/frontend:latest
            # 4. Stop and remove old container
            docker stop frontend || true
            docker rm frontend || true
            # 5. Create network if not exists
            docker network inspect appnet >/dev/null 2>&1 || docker network create appnet
            # 6. Run Frontend Container
            # Frontend ko port 3000 par chalayenge (phir Nginx ise listen karega)
            docker run -d \
              --name frontend \
              --network appnet \
              -p 3000:3000 \
              --restart always \
              ghcr.io/$IMAGE_NAME/frontend:latest
            # 7. Cleanup
            docker image prune -af









